{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zhinees/energieprijzen-nl/main/schema/zonnepanelen.schema.json",
  "title": "data/zonnepanelen.json",
  "description": "Aanschafprijs van zonnepanelen op een woning per Wp (compleet, incl. installatie; 0% btw), bandbreedte met bronnen.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "gegenereerdOp",
    "gecontroleerdOp",
    "valuta",
    "omschrijving",
    "prijsPerWp",
    "bronnen"
  ],
  "properties": {
    "gegenereerdOp": {
      "type": "string",
      "format": "date-time"
    },
    "valuta": {
      "const": "EUR"
    },
    "gecontroleerdOp": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "omschrijving": {
      "type": "string"
    },
    "prijsPerWp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "richtwaarde",
        "van",
        "tot"
      ],
      "properties": {
        "richtwaarde": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 5
        },
        "van": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 5
        },
        "tot": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 5
        }
      }
    },
    "bronnen": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "datum"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "datum": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "notitie": {
            "type": "string"
          }
        }
      }
    }
  }
}
