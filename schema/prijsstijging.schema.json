{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zhinees/energieprijzen-nl/main/schema/prijsstijging.schema.json",
  "title": "data/prijsstijging.json",
  "description": "Standaard prijsstijging per jaar van de marktprijs van stroom (procentPerJaar), en per energiedrager (perDrager: gas, brandstof), met de bron (pbl, cpb of terugval) en de onderliggende ramingen.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "gegenereerdOp",
    "gecontroleerdOp",
    "standaard",
    "omschrijving",
    "volgorde",
    "terugvalProcentPerJaar",
    "perDrager"
  ],
  "properties": {
    "gegenereerdOp": {
      "type": "string",
      "format": "date-time"
    },
    "standaard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "procentPerJaar",
        "bron",
        "berekening"
      ],
      "properties": {
        "procentPerJaar": {
          "type": "number",
          "minimum": -20,
          "maximum": 30
        },
        "bron": {
          "enum": [
            "pbl",
            "cpb",
            "terugval"
          ]
        },
        "berekening": {
          "type": "string"
        }
      }
    },
    "gecontroleerdOp": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "omschrijving": {
      "type": "string"
    },
    "volgorde": {
      "type": "string"
    },
    "pbl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publicatie",
        "url",
        "datum",
        "tabel",
        "prijspeil",
        "groothandelsprijsPerMWh"
      ],
      "properties": {
        "publicatie": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "datum": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "notitie": {
          "type": "string"
        },
        "tabel": {
          "type": "string"
        },
        "prijspeil": {
          "type": "integer"
        },
        "groothandelsprijsPerMWh": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "vanJaar",
            "van",
            "naarJaar",
            "naar"
          ],
          "properties": {
            "vanJaar": {
              "type": "integer"
            },
            "van": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "naarJaar": {
              "type": "integer"
            },
            "naar": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "bandbreedteNaar": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "van",
            "tot"
          ],
          "properties": {
            "van": {
              "type": "number"
            },
            "tot": {
              "type": "number"
            }
          }
        }
      }
    },
    "cpb": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publicatie",
        "url",
        "datum",
        "inflatieCpi"
      ],
      "properties": {
        "publicatie": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "datum": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "notitie": {
          "type": "string"
        },
        "inflatieCpi": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^\\d{4}$"
          },
          "additionalProperties": {
            "type": "number"
          }
        }
      }
    },
    "terugvalProcentPerJaar": {
      "type": "number",
      "minimum": -20,
      "maximum": 30
    },
    "dragers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gas": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "omschrijving"
          ],
          "properties": {
            "omschrijving": {
              "type": "string"
            },
            "pbl": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "publicatie",
                "url",
                "datum",
                "tabel",
                "prijspeil",
                "prijs"
              ],
              "properties": {
                "publicatie": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "datum": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "notitie": {
                  "type": "string"
                },
                "tabel": {
                  "type": "string"
                },
                "prijspeil": {
                  "type": "integer"
                },
                "prijs": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "eenheid",
                    "vanJaar",
                    "van",
                    "naarJaar",
                    "naar"
                  ],
                  "properties": {
                    "eenheid": {
                      "type": "string"
                    },
                    "vanJaar": {
                      "type": "integer"
                    },
                    "van": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "naarJaar": {
                      "type": "integer"
                    },
                    "naar": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  }
                }
              }
            }
          }
        },
        "brandstof": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "omschrijving"
          ],
          "properties": {
            "omschrijving": {
              "type": "string"
            },
            "pbl": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "publicatie",
                "url",
                "datum",
                "tabel",
                "prijspeil",
                "prijs"
              ],
              "properties": {
                "publicatie": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "datum": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "notitie": {
                  "type": "string"
                },
                "tabel": {
                  "type": "string"
                },
                "prijspeil": {
                  "type": "integer"
                },
                "prijs": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "eenheid",
                    "vanJaar",
                    "van",
                    "naarJaar",
                    "naar"
                  ],
                  "properties": {
                    "eenheid": {
                      "type": "string"
                    },
                    "vanJaar": {
                      "type": "integer"
                    },
                    "van": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "naarJaar": {
                      "type": "integer"
                    },
                    "naar": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "perDrager": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gas",
        "brandstof"
      ],
      "properties": {
        "gas": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "procentPerJaar",
            "bron",
            "berekening",
            "omschrijving"
          ],
          "properties": {
            "procentPerJaar": {
              "type": "number",
              "minimum": -20,
              "maximum": 30
            },
            "bron": {
              "enum": [
                "pbl",
                "cpb",
                "terugval"
              ]
            },
            "berekening": {
              "type": "string"
            },
            "omschrijving": {
              "type": "string"
            }
          }
        },
        "brandstof": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "procentPerJaar",
            "bron",
            "berekening",
            "omschrijving"
          ],
          "properties": {
            "procentPerJaar": {
              "type": "number",
              "minimum": -20,
              "maximum": 30
            },
            "bron": {
              "enum": [
                "pbl",
                "cpb",
                "terugval"
              ]
            },
            "berekening": {
              "type": "string"
            },
            "omschrijving": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
