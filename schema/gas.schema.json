{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zhinees/energieprijzen-nl/main/schema/gas.schema.json",
  "title": "data/gas.json",
  "description": "Gemiddeld vast of variabel gascontract voor huishoudens per maand (CBS StatLine 85592NED), incl. btw. Gemaakt door `npm run vast`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "gegenereerdOp",
    "valuta",
    "inclBtw",
    "omschrijving",
    "bron",
    "laatste",
    "maanden"
  ],
  "$defs": {
    "maand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maand",
        "leveringPerM3",
        "energiebelastingPerM3",
        "totaalPerM3",
        "vastPerJaar",
        "netbeheerPerJaar"
      ],
      "properties": {
        "maand": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}$"
        },
        "leveringPerM3": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 5
        },
        "energiebelastingPerM3": {
          "type": "number",
          "minimum": 0,
          "maximum": 3
        },
        "totaalPerM3": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 8
        },
        "vastPerJaar": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        "netbeheerPerJaar": {
          "type": "number",
          "minimum": 0,
          "maximum": 1500
        }
      }
    }
  },
  "properties": {
    "gegenereerdOp": {
      "type": "string",
      "format": "date-time"
    },
    "valuta": {
      "const": "EUR"
    },
    "inclBtw": {
      "const": true
    },
    "omschrijving": {
      "type": "string"
    },
    "bron": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "naam",
        "tabel",
        "url",
        "licentie"
      ],
      "properties": {
        "naam": {
          "type": "string"
        },
        "tabel": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "licentie": {
          "type": "string"
        }
      }
    },
    "laatste": {
      "$ref": "#/$defs/maand"
    },
    "maanden": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/maand"
      }
    }
  }
}
