{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zhinees/energieprijzen-nl/main/schema/prijsstijging-config.schema.json",
  "title": "prijsstijging/prijsstijging.json",
  "description": "Prijsstijging per jaar van de marktprijs van stroom: PBL (KEV) en CPB (MEV), met de hand overgenomen, met bronnen.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "gecontroleerdOp",
    "omschrijving",
    "volgorde",
    "terugvalProcentPerJaar"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "$comment": {
      "type": "string"
    },
    "gecontroleerdOp": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "omschrijving": {
      "type": "string"
    },
    "volgorde": {
      "type": "string"
    },
    "pbl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publicatie",
        "url",
        "datum",
        "tabel",
        "prijspeil",
        "groothandelsprijsPerMWh"
      ],
      "properties": {
        "publicatie": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "datum": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "notitie": {
          "type": "string"
        },
        "tabel": {
          "type": "string"
        },
        "prijspeil": {
          "type": "integer"
        },
        "groothandelsprijsPerMWh": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "vanJaar",
            "van",
            "naarJaar",
            "naar"
          ],
          "properties": {
            "vanJaar": {
              "type": "integer"
            },
            "van": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "naarJaar": {
              "type": "integer"
            },
            "naar": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "bandbreedteNaar": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "van",
            "tot"
          ],
          "properties": {
            "van": {
              "type": "number"
            },
            "tot": {
              "type": "number"
            }
          }
        }
      }
    },
    "cpb": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publicatie",
        "url",
        "datum",
        "inflatieCpi"
      ],
      "properties": {
        "publicatie": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "datum": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "notitie": {
          "type": "string"
        },
        "inflatieCpi": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^\\d{4}$"
          },
          "additionalProperties": {
            "type": "number"
          }
        }
      }
    },
    "terugvalProcentPerJaar": {
      "type": "number",
      "minimum": -20,
      "maximum": 30
    }
  }
}
