{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zhinees/energieprijzen-nl/main/schema/brandstof.schema.json",
  "title": "data/brandstof.json",
  "description": "Gemiddelde pompprijs van benzine (Euro95) en diesel per liter (CBS StatLine 80416NED), incl. btw en accijns: de laatste 30 dagen en per maand. Gemaakt door `npm run brandstof`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "gegenereerdOp",
    "valuta",
    "inclBtw",
    "omschrijving",
    "bron",
    "laatste",
    "maanden"
  ],
  "$defs": {
    "maand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maand",
        "dagen",
        "benzinePerLiter",
        "dieselPerLiter"
      ],
      "properties": {
        "maand": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}$"
        },
        "dagen": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31
        },
        "benzinePerLiter": {
          "type": "number",
          "exclusiveMinimum": 0.5,
          "maximum": 5
        },
        "dieselPerLiter": {
          "type": "number",
          "exclusiveMinimum": 0.5,
          "maximum": 5
        }
      }
    }
  },
  "properties": {
    "gegenereerdOp": {
      "type": "string",
      "format": "date-time"
    },
    "valuta": {
      "const": "EUR"
    },
    "inclBtw": {
      "const": true
    },
    "omschrijving": {
      "type": "string"
    },
    "bron": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "naam",
        "tabel",
        "url",
        "licentie"
      ],
      "properties": {
        "naam": {
          "type": "string"
        },
        "tabel": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "licentie": {
          "type": "string"
        }
      }
    },
    "laatste": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "van",
        "tot",
        "dagen",
        "benzinePerLiter",
        "dieselPerLiter"
      ],
      "properties": {
        "van": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "tot": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "dagen": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31
        },
        "benzinePerLiter": {
          "type": "number",
          "exclusiveMinimum": 0.5,
          "maximum": 5
        },
        "dieselPerLiter": {
          "type": "number",
          "exclusiveMinimum": 0.5,
          "maximum": 5
        }
      }
    },
    "maanden": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/maand"
      }
    }
  }
}
